{
  "builds": [
    {
      "src": "ecommerce-frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "ecommerce-frontend/dist"
      }
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/ecommerce-frontend/index.html"
    }
  ]
}